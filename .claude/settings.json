{
  "permissions": {
    "deny": [
      "Edit(packages/api-types/types/**)",
      "Edit(**/routeTree.gen.ts)",
      "Edit(**/__generated__/**)",
      "Edit(apps/docs/features/docs/generated/**)",
      "Edit(apps/www/.generated/**)",
      "Edit(supabase/functions/common/database-types.ts)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard origin/*)",
      "Bash(git clean -fdx*)"
    ],
    "allow": [
      "Read",
      "Edit",
      "Bash(git *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(uv *)",
      "Bash(pip *)",
      "Bash(ruff *)",
      "Bash(pytest *)",
      "Bash(make *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/install_pkgs.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/format_and_lint.sh",
            "statusMessage": "Formatting & linting..."
          }
        ]
      }
    ]
  }
}
